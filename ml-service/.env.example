# ML Service Configuration
# Copy to .env - it is loaded automatically at startup

# Server Settings
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# MongoDB (same database as the backend). Used by the training scripts and to compute
# the historical averages for discharge and cleaning predictions (defaults are used if unreachable)
MONGO_URI=mongodb://localhost:27017/bedmanager
# MONGO_TIMEOUT_MS=20000
# HISTORY_CACHE_TTL_SECONDS=600
# HISTORY_RETRY_SECONDS=60

# Logging
LOG_LEVEL=INFO
