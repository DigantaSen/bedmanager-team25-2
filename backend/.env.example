PORT=5001
# MongoDB Connection URI
# For local MongoDB: mongodb://localhost:27017/bedmanager
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/bedmanager
MONGO_URI=mongodb://localhost:27017/bedmanager
NODE_ENV=development

# JWT signing secret (required, at least 32 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional token lifetime (default: 7d)
# JWT_EXPIRES_IN=7d

# ML Service URL
ML_SERVICE_URL=http://localhost:8000

# Email (report sending). Gmail needs 2-Step Verification on and a 16-character
# App Password (Google Account -> Security -> App passwords) - a normal account
# password is rejected. Leave SMTP_USER/SMTP_PASS empty to disable report emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=